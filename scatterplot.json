{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,

  "data": {"url": "tornado_data.csv"},

  "params": [
    {"name": "selectedState", "value": ""},
    {"name": "selectedYear", "value": "All" },
    {"name": "includeNonFatal", "value": false}
  ],

  "transform": [
    { "filter": "datum.mag != -9 && datum.yr >= 2020 && datum.st != 'PR' && datum.st != 'VI' && (includeNonFatal || datum.fat > 0) && datum.len > 0 && datum.wid > 0" },
    { "filter": "(!selectedState || datum.st == selectedState)" },
    { "filter": "(selectedYear == 'All') || (datum.yr == selectedYear)" }
  ],

  "mark": "point",

  "encoding": {
    "x": {
      "field": "len",
      "type": "quantitative",
      "title": "Track Length (miles)"
    },
    "y": {
      "field": "wid",
      "type": "quantitative",
      "title": "Path Width (yards)"
    },
    "color": {
      "field": "mag",
      "type": "ordinal",
      "legend": null,
      "scale": { "range": ["#377eb8", "#4daf4a", "#ffd700", "#e41a1c"] }
    },
    "tooltip": [
      {"field": "date", "type": "temporal", "title": "Date"},
      {"field": "st", "type": "nominal", "title": "State"},
      {"field": "len", "type": "quantitative", "title": "Track Length (mi)"},
      {"field": "wid", "type": "quantitative", "title": "Path Width (yd)"},
      {"field": "mag", "type": "ordinal", "title": "EF Rating"}
    ]
  }
}
