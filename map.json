{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#f5f5f5",
  "width": 900,
  "height": 400,
  
  "projection": {
    "type": "albersUsa"
  },

  "params": [
    {
      "name": "selectedState",
      "value": "",
      "bind": {
        "input": "select",
        "element": "#stateControl",
        "options": [
           "",
        "AL","AK","AZ","AR","CA","CO","CT","DE","FL","GA","HI","ID","IL","IN","IA","KS","KY","LA",
        "ME","MD","MA","MI","MN","MS","MO","MT","NE","NV","NH","NJ","NM","NY","NC","ND",
        "OH","OK","OR","PA","RI","SC","SD","TN","TX","UT","VT","VA","WA","WI","WV","WY"
        ],
        "labels": [
"All",
        "Alabama","Alaska","Arizona","Arkansas","California","Colorado","Connecticut","Delaware","Florida",
        "Georgia","Hawaii","Idaho","Illinois","Indiana","Iowa","Kansas","Kentucky","Louisiana",
        "Maine","Maryland","Massachusetts","Michigan","Minnesota","Mississippi","Missouri","Montana",
        "Nebraska","Nevada","New Hampshire","New Jersey","New Mexico","New York","North Carolina","North Dakota",
        "Ohio","Oklahoma","Oregon","Pennsylvania","Rhode Island","South Carolina","South Dakota","Tennessee",
        "Texas","Utah","Vermont","Virginia","Washington","Wisconsin","West Virginia","Wyoming"        ],
        "name": "Select State: "
      }
    },
    {
      "name": "includeNonFatal",
      "value": false,
      "bind": {"input": "checkbox", "element": "#nonFatalControl", "name": "Include non-fatal tornadoes"}
    },
    { "name": "selectedYear", "value": "All" }
  ],

  "config": {
    "view": {
      "stroke": "black",
      "strokeWidth": 2
    }
  },
  "layer": [
    {
      "data": {
        "url": "ne_110m.json",
        "format": {"type": "topojson", "feature": "ne_110m_admin_1_states_provinces"}
      },

      "mark": {"type": "geoshape", "fill": "white", "stroke": "black"}
    },
    {
      "data": {"graticule": {"step": [5, 5]}},
      "mark": {"type": "geoshape", "stroke": "#ccc", "fill": null}
    },
    {
      "data": {"url": "tornado_data.csv"},
      "transform": [
        {
          "filter": "datum.mag != -9 && datum.yr >= 2020 && datum.fat == 0 && datum.st != 'PR' && datum.st != 'VI' && (!selectedState || datum.st == selectedState) && includeNonFatal"
        },
        { "filter": "(selectedYear == 'All') || (datum.yr == selectedYear)" }
      ],
      "mark": {"type": "point"},
      "encoding": {
        "longitude": {"field": "slon", "type": "quantitative"},
        "latitude": {"field": "slat", "type": "quantitative"},
        "size": {"value": 50}, 
        "color": {"value": "lightgrey"},
        "tooltip": [
          {"field": "date", "type": "ordinal", "title": "Date"},
          {"field": "st", "type": "nominal", "title": "State"},
          {"field": "mag", "type": "ordinal", "title": "EF Rating"},
          {"field": "fat", "type": "quantitative", "title": "# of fatalities"},
          {"field": "len", "type": "quantitative", "title": "Track Length (mi)"}
        ]
      }
    },
    {
      "data": {"url": "tornado_data.csv"},
      "transform": [
        {
          "filter": "datum.mag != -9 && datum.yr >= 2020 && datum.fat > 0 && datum.st != 'PR' && datum.st != 'VI' && (!selectedState || datum.st == selectedState)"
        },
        { "filter": "(selectedYear == 'All') || (datum.yr == selectedYear)" }
      ],
      "mark": {"type": "point"},
      "encoding": {
        "longitude": {"field": "slon", "type": "quantitative"},
        "latitude": {"field": "slat", "type": "quantitative"},
        "size": {
          "field": "fat",
          "type": "quantitative",
          "title": "# of fatalities",
          "scale": {"domain": [0, 60], "range": [100, 2000]}
        },
        "color": {
          "field": "mag",
          "type": "ordinal",
          "legend": {
            "title": "EF rating (damage)",
            "labelExpr": "datum.label == '0' ? 'EF0 (light)' : datum.label == '1' ? 'EF1 (moderate)' : datum.label == '2' ? 'EF2 (considerable)' : datum.label == '3' ? 'EF3 (severe)' : datum.label == '4' ? 'EF4 (devastating)' : datum.label == '5' ? 'F5 (incredible)' : datum.label"
          },
          "scale": {
            "range": ["#377eb8", "#4daf4a", "#ffd700", "#e41a1c"]
          }
        },
        "tooltip": [
          {"field": "date", "type": "ordinal", "title": "Date"},
          {"field": "st", "type": "nominal", "title": "State"},
          {"field": "mag", "type": "ordinal", "title": "EF Rating"},
          {"field": "fat", "type": "quantitative", "title": "# of fatalities"},
          {"field": "len", "type": "quantitative", "title": "Track Length (mi)"}
        ]
      }
    },
    {
      "data": {"url": "tornado_data.csv"},
      "transform": [
        {
          "filter": "datum.mag != -9 && datum.yr >= 2020 && datum.st != 'PR' && datum.st != 'VI' && (!selectedState || datum.st == selectedState) && (includeNonFatal || datum.fat > 0)"
        },
        { "filter": "(selectedYear == 'All') || (datum.yr == selectedYear)" },
        {"aggregate": [{"op": "count", "as": "tornado_count"}]},
        {"calculate": "'Total Tornadoes: ' + datum.tornado_count", "as": "label"}
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 5,
        "dy": 200,
        "fontSize": 16,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {"field": "label", "type": "nominal"}
      }
    }
  ]
}
