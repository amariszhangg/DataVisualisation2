{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Distribution of Tornado Losses (Log Scale, $ millions)",
  "width": 600,
  "height": 400,

  "data": {
    "url": "tornado_data.csv"
  },

  "transform": [
    {
      "filter": "datum.mag != -9 && datum.yr >= 2020 && datum.yr <= 2024 && datum.st != 'PR' && datum.st != 'VI' && datum.fat > 0 && datum.loss > 0"
    },
    {
      "calculate": "datum.loss / 1000000",
      "as": "loss"
    },
    {
      "calculate": "log(datum.loss)",
      "as": "log_loss"
    }
  ],

  "mark": "bar",

  "encoding": {
    "x": {
      "field": "log_loss",
      "bin": {"maxbins": 20},
      "type": "quantitative",
      "title": "Loss (Millions of $)",
      "axis": {
        "labelExpr": "format(exp(datum.value), '.3~g')" 
      }
    },
    "y": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "Number of Tornadoes"
    },
    "color": {
      "field": "mag",
      "type": "ordinal",
      "title": "EF Rating",
      "scale": {
        "range": ["#377eb8", "#4daf4a", "#ffd700", "#e41a1c"]
      }
    },
    "tooltip": [
      {"field": "loss", "type": "quantitative", "title": "Loss (Millions $)", "format": ".2f"},
      {"field": "mag", "type": "ordinal", "title": "EF Rating"},
      {"aggregate": "count", "type": "quantitative", "title": "Tornadoes"}
    ]
  }
}
